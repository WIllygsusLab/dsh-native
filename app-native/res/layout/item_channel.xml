<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@id/channel_row"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:minHeight="56dp" android:gravity="center_vertical"
    android:orientation="horizontal" android:paddingStart="@dimen/space_12"
    android:paddingEnd="@dimen/space_12" android:paddingTop="@dimen/space_8"
    android:paddingBottom="@dimen/space_8"
    android:background="?android:attr/selectableItemBackground">
    <TextView android:id="@+id/channel_icon" android:layout_width="24dp"
        android:layout_height="24dp" android:gravity="center" android:textColor="@color/muted"
        android:textSize="15sp" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_10" android:layout_weight="1"
        android:orientation="vertical">
        <TextView android:id="@id/channel_row_title" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1"
            android:textColor="@color/text" android:textSize="15sp"
            android:fontFamily="sans-serif-medium" />
        <TextView android:id="@id/channel_row_snippet" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1"
            android:textColor="@color/muted" android:textSize="12sp" android:visibility="gone" />
    </LinearLayout>
    <TextView android:id="@id/channel_row_state" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:layout_marginStart="@dimen/space_6"
        android:textColor="@color/faint" android:textSize="11sp" android:visibility="gone" />
    <View android:id="@id/channel_row_unread" android:layout_width="8dp" android:layout_height="8dp"
        android:layout_marginStart="@dimen/space_6" android:background="@drawable/bg_dot"
        android:visibility="gone" />
    <TextView android:id="@id/channel_row_time" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:layout_marginStart="@dimen/space_6"
        android:textColor="@color/muted" android:textSize="11sp" android:visibility="gone" />
</LinearLayout>
