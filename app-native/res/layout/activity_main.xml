<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@id/root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/bg" android:orientation="vertical">
    <LinearLayout android:id="@id/topbar" android:layout_width="match_parent"
        android:layout_height="@dimen/topbar_height" android:background="@color/bg_rail"
        android:gravity="center_vertical" android:orientation="horizontal"
        android:paddingStart="@dimen/space_8" android:paddingEnd="@dimen/space_6">
        <ImageButton android:id="@id/rail_toggle" android:layout_width="@dimen/touch_min"
            android:layout_height="@dimen/touch_min" android:background="@drawable/bg_icon_button"
            android:contentDescription="@string/rail_toggle_show_desc" android:padding="12dp"
            android:src="@drawable/ic_menu" android:tint="@color/text_soft" />
        <ImageButton android:id="@id/topbar_back" android:layout_width="@dimen/touch_min"
            android:layout_height="@dimen/touch_min" android:background="@drawable/bg_icon_button"
            android:contentDescription="@string/back" android:padding="12dp"
            android:src="@drawable/ic_back" android:tint="@color/text_soft"
            android:visibility="gone" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical"
            android:paddingStart="@dimen/space_6">
            <TextView android:id="@id/topbar_title" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1"
                android:text="@string/app_name" style="@style/Text.Title3" />
            <TextView android:id="@id/conn_status"
                android:contentDescription="Connection status" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:ellipsize="middle" android:maxLines="1"
                android:text="@string/connect_working" style="@style/Text.Micro" />
        </LinearLayout>
        <ImageButton android:id="@id/topbar_action" android:layout_width="@dimen/touch_min"
            android:layout_height="@dimen/touch_min" android:background="@drawable/bg_icon_button"
            android:contentDescription="@string/search" android:padding="12dp"
            android:src="@drawable/ic_search" android:tint="@color/text_soft" />
        <ImageButton android:id="@id/topbar_action_2" android:layout_width="@dimen/touch_min"
            android:layout_height="@dimen/touch_min" android:background="@drawable/bg_icon_button"
            android:contentDescription="@string/more" android:padding="12dp"
            android:src="@drawable/ic_more" android:tint="@color/text_soft" />
    </LinearLayout>
    <LinearLayout android:id="@id/offline_banner" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:background="@color/surface_2"
        android:gravity="center_vertical" android:orientation="horizontal"
        android:paddingStart="@dimen/space_12" android:paddingEnd="@dimen/space_8"
        android:paddingTop="@dimen/space_6" android:paddingBottom="@dimen/space_6"
        android:visibility="gone">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="@string/disconnected"
            android:textColor="@color/amber" android:textSize="12sp" />
        <Button android:id="@id/reconnect_button" android:layout_width="wrap_content"
            android:layout_height="36dp" android:background="@drawable/bg_button_ghost"
            android:text="@string/reconnect" android:textColor="@color/text_soft"
            android:textSize="12sp" />
    </LinearLayout>
    <View android:layout_width="match_parent" android:layout_height="1dp"
        android:background="@color/stroke_soft" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:orientation="horizontal">
        <LinearLayout android:id="@id/server_rail" android:layout_width="@dimen/rail_width"
            android:layout_height="match_parent" android:background="@color/bg_rail"
            android:gravity="center_horizontal" android:orientation="vertical"
            android:paddingTop="@dimen/space_8">
            <FrameLayout android:id="@id/rail_host" android:layout_width="@dimen/rail_icon"
                android:layout_height="@dimen/rail_icon" android:background="@drawable/bg_logo">
                <TextView android:id="@id/rail_host_name" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:layout_gravity="center"
                    android:text="DSH" android:textColor="@color/accent"
                    android:textSize="12sp" android:fontFamily="sans-serif-medium" />
            </FrameLayout>
            <!-- UI overhaul (spec §2): WORKSPACES caption, scrollable labeled workspace rows,
                 divider, then pinned Home + Tools rows. -->
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_10" android:paddingStart="@dimen/space_12"
                android:fontFamily="sans-serif-medium" android:letterSpacing="0.06"
                android:text="@string/workspaces" android:textAllCaps="true"
                android:textColor="@color/muted" android:textSize="9sp" />
            <ScrollView android:id="@id/rail_scroll" android:layout_width="match_parent"
                android:layout_height="0dp" android:layout_weight="1"
                android:scrollbars="vertical">
                <LinearLayout android:id="@id/rail_spaces" android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" android:gravity="center_horizontal" />
            </ScrollView>
            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:layout_marginStart="@dimen/space_12" android:layout_marginEnd="@dimen/space_12"
                android:layout_marginTop="@dimen/space_6" android:layout_marginBottom="@dimen/space_6"
                android:background="@color/stroke_soft" />
            <LinearLayout android:id="@id/rail_home" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:minHeight="@dimen/touch_min"
                android:background="@drawable/bg_rail_item" android:clickable="true"
                android:focusable="true" android:contentDescription="@string/rail_home_desc"
                android:gravity="center_vertical" android:orientation="horizontal"
                android:paddingStart="@dimen/space_12" android:paddingEnd="@dimen/space_12">
                <View android:id="@id/rail_selected_indicator" android:layout_width="3dp"
                    android:layout_height="28dp" android:background="@color/accent"
                    android:visibility="gone" />
                <ImageView android:id="@id/rail_home_icon" android:layout_width="@dimen/rail_tile"
                    android:layout_height="@dimen/rail_tile" android:layout_marginStart="@dimen/space_6"
                    android:background="@drawable/bg_tile" android:padding="5dp"
                    android:src="@drawable/ic_grid" />
                <TextView android:id="@id/rail_item_label" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:layout_marginStart="@dimen/space_8"
                    android:ellipsize="end" android:maxLines="1" android:text="@string/rail_home_label"
                    android:textColor="@color/text_soft" android:textSize="11sp" />
            </LinearLayout>
            <LinearLayout android:id="@id/rail_tools" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:minHeight="@dimen/touch_min"
                android:background="@drawable/bg_rail_item" android:clickable="true"
                android:focusable="true" android:contentDescription="@string/rail_tools_desc"
                android:gravity="center_vertical" android:orientation="horizontal"
                android:paddingStart="@dimen/space_12" android:paddingEnd="@dimen/space_12">
                <View android:id="@id/rail_selected_indicator" android:layout_width="3dp"
                    android:layout_height="28dp" android:background="@color/accent"
                    android:visibility="gone" />
                <ImageView android:id="@id/rail_tools_icon" android:layout_width="@dimen/rail_tile"
                    android:layout_height="@dimen/rail_tile" android:layout_marginStart="@dimen/space_6"
                    android:background="@drawable/bg_tile" android:padding="5dp"
                    android:src="@drawable/ic_gear" />
                <TextView android:id="@id/rail_item_label" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:layout_marginStart="@dimen/space_8"
                    android:ellipsize="end" android:maxLines="1" android:text="@string/rail_tools_label"
                    android:textColor="@color/text_soft" android:textSize="11sp" />
                <View android:id="@id/rail_tools_badge" android:layout_width="8dp"
                    android:layout_height="8dp" android:layout_marginStart="@dimen/space_4"
                    android:layout_marginEnd="@dimen/space_2"
                    android:background="@drawable/bg_dot" android:backgroundTint="@color/amber"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
        <FrameLayout android:id="@id/main_screen" android:layout_width="0dp"
            android:layout_height="match_parent" android:layout_weight="1" />
            <ProgressBar android:id="@id/loading_spinner" android:layout_width="32dp"
                android:layout_height="32dp" android:layout_gravity="center"
                android:indeterminateTint="@color/accent" android:visibility="gone" />
    </LinearLayout>
    <View android:layout_width="match_parent" android:layout_height="1dp"
        android:background="@color/stroke_soft" />
    <LinearLayout android:id="@id/bottom_tabs" android:layout_width="match_parent"
        android:layout_height="@dimen/bottomnav_height" android:background="@color/bg_rail"
        android:orientation="horizontal" android:baselineAligned="false">
        <TextView android:id="@id/tab_chats" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:gravity="center" android:text="@string/tab_chats"
            android:textColor="@color/accent" android:textSize="11sp" android:fontFamily="sans-serif-medium" />
        <TextView android:id="@id/tab_agents" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:gravity="center" android:text="@string/tab_agents"
            android:textColor="@color/muted" android:textSize="11sp" />
        <TextView android:id="@id/tab_plugins" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:gravity="center" android:text="@string/tab_plugins"
            android:textColor="@color/muted" android:textSize="11sp" />
        <TextView android:id="@id/tab_jobs" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:gravity="center" android:text="@string/tab_jobs"
            android:textColor="@color/muted" android:textSize="11sp" />
        <TextView android:id="@id/tab_you" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:gravity="center" android:text="@string/tab_you"
            android:textColor="@color/muted" android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
