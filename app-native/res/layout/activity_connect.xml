<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@id/connect_screen"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/bg" android:fillViewport="true" android:scrollbars="none">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingStart="@dimen/space_24"
        android:paddingEnd="@dimen/space_24" android:paddingTop="48dp" android:paddingBottom="@dimen/space_24">
        <FrameLayout android:layout_width="64dp" android:layout_height="64dp"
            android:layout_gravity="center_horizontal" android:background="@drawable/bg_logo">
            <ImageView android:layout_width="32dp" android:layout_height="32dp"
                android:layout_gravity="center" android:contentDescription="@null"
                android:src="@drawable/ic_terminal" />
        </FrameLayout>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal" android:layout_marginTop="@dimen/space_20"
            android:text="@string/connect_title" style="@style/Text.Display" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8" android:gravity="center"
            android:text="@string/connect_subtitle" style="@style/Text.Caption" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_24" android:background="@drawable/bg_card"
            android:orientation="vertical" android:padding="@dimen/space_16">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/host" style="@style/Text.Label" />
            <EditText android:id="@id/connect_url_input" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_6"
                android:hint="@string/connect_url_hint" android:inputType="textUri"
                android:maxLines="1" android:importantForAutofill="no"
                android:background="@drawable/bg_input" android:padding="@dimen/space_12"
                android:textColor="@color/text" android:textColorHint="@color/faint"
                android:textSize="15sp" />
            <TextView android:id="@id/connect_last" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_8"
                android:textColor="@color/accent" android:textSize="12sp" android:visibility="gone" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12" android:text="@string/connect_token_label"
                style="@style/Text.Label" />
            <EditText android:id="@+id/connect_token" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_6"
                android:hint="@string/connect_token_hint" android:inputType="textPassword"
                android:maxLines="1" android:importantForAutofill="no"
                android:background="@drawable/bg_input" android:padding="@dimen/space_12"
                android:textColor="@color/text" android:textColorHint="@color/faint"
                android:textSize="15sp" />
            <Button android:id="@id/connect_pair_button" android:layout_width="match_parent"
                android:layout_height="48dp" android:layout_marginTop="@dimen/space_16"
                android:text="@string/connect_button" style="@style/Button.Primary" />
            <ProgressBar android:id="@id/connect_progress" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/space_8" android:visibility="gone" />
            <TextView android:id="@id/connect_error" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_12"
                android:textColor="@color/red" android:textSize="12sp" android:visibility="gone" />
            <Button android:id="@id/connect_retry_button" android:layout_width="match_parent"
                android:layout_height="44dp" android:layout_marginTop="@dimen/space_8"
                android:background="@drawable/bg_button_ghost" android:text="@string/retry"
                android:textColor="@color/text_soft" android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16" android:gravity="center"
            android:text="@string/connect_scan_m2" style="@style/Text.Caption" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8" android:gravity="center"
            android:text="@string/connect_footer" style="@style/Text.Micro" />
    </LinearLayout>
</ScrollView>
