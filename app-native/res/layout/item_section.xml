<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:paddingStart="@dimen/space_12"
    android:paddingEnd="@dimen/space_12" android:paddingTop="@dimen/space_2"
    android:paddingBottom="@dimen/space_2">
    <TextView android:id="@id/channel_group_header" android:layout_width="match_parent"
        android:layout_height="32dp" android:gravity="bottom"
        android:paddingBottom="@dimen/space_4" android:textColor="@color/muted"
        android:textSize="11sp" android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.06" android:textAllCaps="true" />
    <TextView android:id="@id/channel_group_caption" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:paddingBottom="@dimen/space_4"
        android:textColor="@color/muted" android:textSize="10sp"
        android:visibility="gone" />
</LinearLayout>
